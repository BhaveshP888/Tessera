{
  "manifest_version": 3,
  "name": "Tessera — Privacy-First Bookmark Manager",
  "version": "1.0.0",
  "description": "Quick-save bookmarks, notes, and tags into your local-first, E2E encrypted Tessera library with zero AI.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Tessera",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tessera@bookmarks.local",
      "strict_min_version": "109.0"
    }
  }
}
